<!-- Anunț de actualizare. Textul se schimbă în /site-notice.js (config NOTICE). -->
<div class="site-notice" id="site-notice" role="dialog" aria-modal="true" aria-labelledby="site-notice-title" hidden>
  <div class="site-notice__backdrop" data-notice-dismiss></div>
  <div class="site-notice__card">
    <button type="button" class="site-notice__close" data-notice-dismiss aria-label="Închide">&times;</button>
    <span class="site-notice__eyebrow" id="site-notice-eyebrow"></span>
    <h2 id="site-notice-title"></h2>
    <div class="site-notice__body" id="site-notice-body"></div>
    <div class="site-notice__actions">
      <button type="button" class="site-notice__ok" id="site-notice-ok" data-notice-dismiss></button>
      <a class="site-notice__link" id="site-notice-link" data-notice-dismiss hidden></a>
    </div>
  </div>
</div>
