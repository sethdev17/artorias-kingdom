<%
  // ============================================================
  // SOCIAL LINKS — editează DOAR aici când vrei să adaugi o platformă.
  //
  // Format: { label: "Numele platformei", url: "https://link.com/cont" }
  //
  // Linkurile se așază automat pe rânduri noi (flex-wrap), deci poți adăuga
  // oricâte, fără să strici layout-ul.
  // ============================================================
  const socialLinks = [
    { label: "Instagram", url: "https://www.instagram.com/artroiaskingdom.ro/" },                                       
    { label: "TikTok", url: "https://www.tiktok.com/@artorias.kingdom24" },
  ];
%>

<footer class="footer" id="footer">
  <div class="footer-inner">
    <!-- COLOANA 1 — brandul -->
    <div class="footer-brand">
      <a href="/" class="footer-brand__logo-link" aria-label="Artoria's Kingdom România — acasă">
        <img src="/images/logo.png" alt="Artoria's Kingdom România" class="footer-brand__logo" loading="lazy">
      </a>
      <p class="footer-brand__desc">
        Artoria's Kingdom este o comunitate pentru fanii anime și oamenii cu aceleași gusturi și același vibe. Regulile sunt
        clare și pentru toată lumea. Această comunitate este un loc unde fiecare se simte bine, fără prejudecăți.
      </p>
    </div>

    <!-- COLOANA 2 — navigare -->
    <nav class="footer-column" aria-label="Navigare în site">
      <h4>Navigare</h4>
      <ul class="footer-links">
        <li><a href="/">Acasă</a></li>
        <li><a href="/#introducere">Introducere</a></li>
        <li><a href="/#sectiune-server">Ce găsești la noi</a></li>
        <li><a href="/#sectiune-scop">De ce am creat serverul</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/termeni">Reguli și confidențialitate</a></li>
      </ul>
    </nav>

    <!-- COLOANA 3 — urmărește-ne -->
    <div class="footer-column">
      <h4>Urmărește-ne</h4>
      <div class="footer-social">
        <% socialLinks.forEach(function (link) { %>
          <% const extern = /^https?:\/\//.test(link.url); %>
          <a href="<%= link.url %>"
             <% if (extern) { %>target="_blank" rel="noopener noreferrer"<% } %>>
            <%= link.label %>
          </a>
        <% }); %>
      </div>
    </div>
  </div>

  <hr class="footer-divider">
  <div class="footer-bottom">
    <span class="rights">Copyright © 2024-<script>document.write(new Date().getFullYear())</script> Artoria's Kingdom România</span>
    <div class="footer-bottom__links">
      <a href="/termeni">Reguli și confidențialitate</a>
      <a href="/contact">Contact</a>
      <button type="button" class="footer-text-button" data-cookie-settings>Setări cookie-uri</button>
    </div>
  </div>
</footer>
